# ── Core ─────────────────────────────────────────────
PORT=8080
SITE_URL=https://hexmodifications.com
# Long random string. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=
# Token for /admin. Generate the same way. Never share it.
ADMIN_TOKEN=
# Set to "cloudflare" or "proxy" when running behind Cloudflare / nginx so real visitor IPs are used.
TRUST_PROXY=

# ── Patreon feed (Patreon > Developer portal > Create client > Creator's Access Token)
PATREON_ACCESS_TOKEN=
PATREON_CAMPAIGN_ID=

# ── Tebex Headless (Tebex panel > Integrations > API Keys > Public token)
TEBEX_PUBLIC_TOKEN=
TEBEX_STORE_URL=https://hexmodifications.tebex.io

# ── Shopify Storefront API (Shopify admin > Apps > Headless > Storefront token)
SHOPIFY_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=

# ── Discord
# Webhook in a private #inbox channel: contact form messages get posted there.
DISCORD_WEBHOOK_URL=
# Server ID with "Server Widget" enabled: shows live online count on the site.
DISCORD_GUILD_ID=

# ── Chat assistant ("ask hex")
# Works with no setup: the page uses Pollinations' free keyless tier (about 1 reply / 30s per visitor).
# For faster, unlimited replies, set any OpenAI-compatible chat endpoint + key here; the server then
# answers at /api/chat and the key never reaches the browser. Examples: a Pollinations key
# (https://gen.pollinations.ai/v1/chat/completions), Groq, OpenRouter.
CHAT_API_URL=
CHAT_API_KEY=
CHAT_MODEL=
